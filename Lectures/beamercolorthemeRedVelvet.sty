\newcommand{\perparrows}[6]{
    \begin{tikzpicture}
    % Horizontal double-headed arrow
    \draw[#5, line width=#3, {Latex[length=#4]}-{Latex[length=#4]}] 
        (-#1/2, 0) -- (#1/2, 0);
    
    % Vertical double-headed arrow
    \draw[#6, line width=#3, {Latex[length=#4]}-{Latex[length=#4]}] 
        (0, -#2/2) -- (0, #2/2);
    \end{tikzpicture}
}

